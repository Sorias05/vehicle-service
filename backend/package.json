{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{apps,libs,test}/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:user": "node dist/apps/user/src/main.js",
    "start:auth": "node dist/apps/auth/src/main.js",
    "start:vehicle": "node dist/apps/vehicle/src/main.js",
    "start:storage": "node dist/apps/storage/src/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/backend/test/jest-e2e.json",
    "build:auth": "nest build auth",
    "build:user": "nest build user",
    "build:vehicle": "nest build vehicle",
    "build:storage": "nest build storage",
    "build:apps": "npm run build:auth && npm run build:user && npm run build:vehicle && npm run build:storage",
    "build:database": "tsc -p libs/database/tsconfig.json",
    "build:shared": "tsc -p libs/shared/tsconfig.json",
    "build:authlib": "tsc -p libs/authlib/tsconfig.json",
    "build:health": "tsc -p libs/health/tsconfig.json",
    "build:redis": "tsc -p libs/redis/tsconfig.json",
    "build:s3": "tsc -p libs/s3/tsconfig.json",
    "build:rabbitmq": "tsc -p libs/rabbitmq/tsconfig.json",
    "build:libs": "npm run build:database && npm run build:redis && npm run build:s3 && npm run build:rabbitmq && npm run build:authlib && npm run build:shared && npm run build:health",
    "build": "npm run build:libs && npm run build:apps && tsc-alias -p tsconfig.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d libs/database/src/data-source.ts",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d dist/libs/database/src/data-source.js",
    "migration:generate": "npm run typeorm -- migration:generate libs/database/src/migrations/AutoMigration",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:run:prod": "npm run typeorm:prod -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-redis": "^9.0.0",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "express-session": "^1.19.0",
    "pg": "^8.18.0",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^y/storage(|/.*)$": "<rootDir>/libs/storage/src/$1",
      "^y/authlib(|/.*)$": "<rootDir>/libs/authlib/src/$1",
      "^y/health(|/.*)$": "<rootDir>/libs/health/src/$1",
      "^y/redis(|/.*)$": "<rootDir>/libs/redis/src/$1",
      "^y/s3(|/.*)$": "<rootDir>/libs/s3/src/$1",
      "^@app/rabbitmq(|/.*)$": "<rootDir>/libs/rabbitmq/src/$1"
    }
  }
}
