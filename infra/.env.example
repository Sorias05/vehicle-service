# Project identity
PROJECT_NAME=

# Runtime mode
INFRASTRUCTURE_MODE=
K8S_DISTRIBUTION=
K8S_CREATE_CLUSTER=
K8S_CLUSTER_NAME=
K8S_CONTEXT=
K8S_NAMESPACE=

# Down project
K8S_DELETE_CLUSTER=
REMOVE_CLUSTER_COMPONENTS=

# One source of truth: app-key:container-port pairs.
# Remove an entry to skip deploying that application. No DEPLOY_* flags.
APPLICATIONS=
FRONTEND_APPLICATION=

# Shared application behavior. Per-app differences are explicit overrides.
IS_DOCKER=
APP_HEALTH_PATH=

# Images: repository is derived as <PROJECT_NAME>-<app-key>.
IMAGE_REGISTRY=
IMAGE_TAG=
IMAGE_PULL_POLICY=

# Gateway
GATEWAY_NAME=
GATEWAY_CLASS=
GATEWAY_HTTP_PORT=
GATEWAY_HOST_PORT=
GATEWAY_BASE_URL=
GATEWAY_SERVICE_TYPE=

# RBAC
RBAC_NAMESPACE=

# NGINX Gateway Fabric
NGF_RELEASE_NAME=
NGF_NAMESPACE=
NGF_CHART_VERSION=

# Local infrastructure configuration (used by Docker Compose)
POSTGRES_DB=
AWS_DEFAULT_REGION=

# Published infrastructure host ports (used when INFRASTRUCTURE_MODE=compose)
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
RABBITMQ_HOST_PORT=
LOCALSTACK_HOST_PORT=
JAEGER_HOST_PORT=
OTEL_GRPC_HOST_PORT=
OTEL_HTTP_HOST_PORT=
